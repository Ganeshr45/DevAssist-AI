{"title":"DevAssist API","uid":"devassist-api","schemaVersion":39,"version":1,"refresh":"15s","panels":[{"type":"timeseries","title":"HTTP requests per second","gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"sum(rate(http_requests_total[5m])) by (handler)","legendFormat":"{{handler}}"}]},{"type":"timeseries","title":"HTTP p95 latency","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p95"}]},{"type":"stat","title":"HTTP errors per second","gridPos":{"x":0,"y":8,"w":8,"h":5},"targets":[{"expr":"sum(rate(http_requests_total{status=~\"5..\"}[5m]))"}]},{"type":"stat","title":"API process up","gridPos":{"x":8,"y":8,"w":8,"h":5},"targets":[{"expr":"up{job=\"devassist-api\"}"}]},{"type":"timeseries","title":"Requests by status","gridPos":{"x":16,"y":8,"w":8,"h":5},"targets":[{"expr":"sum(rate(http_requests_total[5m])) by (status)","legendFormat":"{{status}}"}]}]}
